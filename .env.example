# Copia este archivo como .env y rellénalo:  cp .env.example .env
# El archivo .env es privado y NO se sube a GitHub.

# API key gratis: https://aistudio.google.com/apikey
GEMINI_API_KEY=pega-aqui-tu-api-key

# Modelo de Gemini (opcional). Más listo pero más lento: gemini-3.5-flash
GEMINI_MODELO=gemini-3.5-flash-lite

# Cómo quieres que NAVI te llame (opcional)
NAVI_USUARIO=

# Tu ciudad, para el clima (opcional). Ejemplo: Madrid  o  Santiago, Chile
NAVI_CIUDAD=

# Voz de NAVI: piper (natural), espeak (robótica retro) o ninguno
NAVI_VOZ=piper
# Modelo de Piper (debe estar en la carpeta voces/)
NAVI_VOZ_PIPER=es_ES-sharvard-medium
# Solo para voces con varios hablantes (sharvard: 0 hombre, 1 mujer)
NAVI_VOZ_PIPER_HABLANTE=1
# Voz de espeak-ng (prueba es-419+f3, es+f2, es-419+m3...)
NAVI_VOZ_ESPEAK=es-419+f3
# Velocidad: 1.0 normal, 1.2 más lenta, 0.8 más rápida
NAVI_VOZ_VELOCIDAD=1.0
# Filtro Wired: 0 = voz limpia, 0.6 = metálica, 1.0 = muy robótica
NAVI_VOZ_FILTRO=0.2
# Tono en semitonos: 0 normal, +5 a +9 aguda estilo anime, -3 más grave
NAVI_VOZ_TONO=3
# Tono base de espeak (0-99, normal 50)
NAVI_VOZ_ESPEAK_TONO=50

# Oído de NAVI (Whisper, local). Presiona Enter vacío para hablarle.
# small = entiende mejor (~500 MB) · base = más rápido (~150 MB) · ninguno = desactivado
NAVI_OIDO=small
# Micrófono: interno = el del PC (recomendado si usas audífonos Bluetooth)
# vacío = el predeterminado del sistema
NAVI_MICROFONO=interno

# Dónde abrir los borradores de correo: gmail (en el navegador) o predeterminado (tu programa de correo)
NAVI_CORREO=gmail

# YouTube (música). Si YouTube bloquea con "confirma que no eres un bot":
# prueba otro cliente (web_embedded, android_music...) o usa las cookies de tu navegador (firefox)
# Vacío = el cliente normal de yt-dlp (necesita deno instalado)
NAVI_YOUTUBE_CLIENTE=
NAVI_YOUTUBE_COOKIES=
